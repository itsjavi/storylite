{
  "name": "storylite-project",
  "version": "0.0.1",
  "private": true,
  "description": "StoryLite - Lightweight alternative to Storybook for HTML, React, Preact, Svelte, Vue, and Solid component stories.",
  "homepage": "https://itsjavi.com/storylite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsjavi/storylite.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:apps": "pnpm --filter \"./apps/*\" run build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build:web": "pnpm -F @storylite/web run build",
    "codegen": "pnpm -r --if-present run codegen",
    "dev": "pnpm -r --if-present --parallel --stream run dev",
    "dev:web": "pnpm -F @storylite/web run dev",
    "dev:storylite": "pnpm -F @storylite/storylite run dev",
    "dev:demos": "pnpm -r --parallel --stream --filter \"./demos/*\" run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "pnpm preview:web",
    "preview:web": "pnpm build && pnpm -F @storylite/web run preview",
    "publint": "pnpm -r --if-present --stream run publint",
    "qa": "pnpm test:full-qa",
    "smoke:react-downstream": "node ./scripts/smoke-react-downstream.mjs",
    "test": "pnpm -r --if-present --parallel --stream run test",
    "test:e2e": "pnpm -F @storylite/e2e run e2e",
    "test:full-qa": "pnpm typecheck && pnpm format:check && pnpm build && pnpm test && pnpm test:e2e",
    "typecheck": "pnpm -r --if-present --parallel --stream run typecheck",
    "update-deps": "pnpm -r update --latest && sleep 2 && pnpm install",
    "pkg:release": "node ./scripts/pkg-release.mjs",
    "pkg:version": "node ./scripts/pkg-version.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.53.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.1"
}
