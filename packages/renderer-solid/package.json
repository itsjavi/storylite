{
  "name": "@storylite/renderer-solid",
  "version": "1.6.0",
  "description": "Solid.js renderer for StoryLite",
  "homepage": "https://itsjavi.com/storylite",
  "bugs": {
    "url": "https://github.com/itsjavi/storylite/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsjavi/storylite.git",
    "directory": "packages/renderer-solid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./static": {
      "types": "./dist/static.d.mts",
      "import": "./dist/static.mjs",
      "default": "./dist/static.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "publint": "publint",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm publint"
  },
  "dependencies": {
    "@storylite/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "solid-js": "^1.9.13",
    "vite-plugin-solid": "2.11.12"
  },
  "peerDependencies": {
    "solid-js": "^1.9.10",
    "vite-plugin-solid": "2.11.8"
  }
}
