{
  "name": "@storylite/renderer-svelte",
  "version": "1.5.3",
  "description": "Svelte renderer for StoryLite",
  "homepage": "https://itsjavi.com/storylite",
  "bugs": {
    "url": "https://github.com/itsjavi/storylite/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsjavi/storylite.git",
    "directory": "packages/renderer-svelte"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./static": {
      "types": "./dist/static.d.mts",
      "import": "./dist/static.mjs",
      "default": "./dist/static.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "publint": "publint",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm publint"
  },
  "dependencies": {
    "@storylite/contracts": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.1.2"
  },
  "devDependencies": {
    "svelte": "^5.56.1"
  },
  "peerDependencies": {
    "svelte": "^5.55.9"
  }
}
