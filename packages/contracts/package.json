{
  "name": "@storylite/contracts",
  "version": "1.6.0",
  "description": "Shared StoryLite contracts for the app, renderer adapters, and downstream projects.",
  "homepage": "https://itsjavi.com/storylite",
  "bugs": {
    "url": "https://github.com/itsjavi/storylite/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsjavi/storylite.git",
    "directory": "packages/contracts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "publint": "publint",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm publint"
  }
}
