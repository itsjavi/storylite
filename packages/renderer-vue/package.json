{
  "name": "@storylite/renderer-vue",
  "version": "1.6.0",
  "description": "Vue renderer for StoryLite",
  "homepage": "https://itsjavi.com/storylite",
  "bugs": {
    "url": "https://github.com/itsjavi/storylite/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsjavi/storylite.git",
    "directory": "packages/renderer-vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./static": {
      "types": "./dist/static.d.mts",
      "import": "./dist/static.mjs",
      "default": "./dist/static.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "publint": "publint",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm publint"
  },
  "dependencies": {
    "@storylite/contracts": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/server-renderer": "^3.5.35",
    "vue": "^3.5.35"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/server-renderer": "^3.5.25",
    "vue": "^3.5.25"
  }
}
