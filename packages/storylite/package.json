{
  "name": "@storylite/storylite",
  "version": "1.5.3",
  "description": "Lightweight alternative to Storybook for HTML, React, Preact, Svelte, Vue, and Solid component stories",
  "keywords": [
    "component-development",
    "component-stories",
    "html",
    "preact",
    "react",
    "solid",
    "storybook",
    "storylite",
    "svelte",
    "vite",
    "vue",
    "web-components"
  ],
  "homepage": "https://itsjavi.com/storylite",
  "bugs": {
    "url": "https://github.com/itsjavi/storylite/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsjavi/storylite.git",
    "directory": "packages/storylite"
  },
  "bin": {
    "storylite": "./bin/storylite.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src/lib/storylite/utils.js"
  ],
  "type": "module",
  "main": "./dist/public.mjs",
  "module": "./dist/public.mjs",
  "types": "./dist/public.d.mts",
  "exports": {
    ".": {
      "types": "./dist/public.d.mts",
      "import": "./dist/public.mjs",
      "default": "./dist/public.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node ./bin/storylite.mjs dev",
    "build": "pnpm build:public && pnpm build:manager",
    "build:manager": "vite build --config manager.vite.config.ts && vite build --config manager.ssr.vite.config.ts",
    "build:public": "tsdown",
    "preview": "node ./bin/storylite.mjs preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "typecheck": "pnpm check",
    "publint": "publint",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm publint",
    "test": "vitest run",
    "version": "node ../../scripts/sync-public-package-versions.mjs --stage"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@storylite/contracts": "workspace:*",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.4",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.17.0",
    "@storylite/preview-host": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.9.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.5.0",
    "typescript": "^6.0.3"
  }
}
